{
  "name": "featherweight",
  "version": "2.1.1",
  "private": true,
  "description": "Figma plugin: export selected frames to a light PDF with real embedded fonts",
  "repository": {
    "type": "git",
    "url": "https://github.com/coffeequickly/featherweight.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "build-figma-plugin --typecheck --watch",
    "build": "build-figma-plugin --typecheck --minify",
    "watch": "build-figma-plugin --typecheck --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools *.mjs && prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"tools/**/*.mjs\" \"*.{mjs,json}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.{mjs,json}\"",
    "test": "vitest run",
    "verify:catalog": "CATALOG_NET=1 vitest run tests/fontCatalog.net.test.ts tests/textPipeline.net.test.ts",
    "compare": ".venv/bin/python tools/compare-pdf.py",
    "install:local": "npm run build && node tools/install-local.mjs",
    "package": "npm run build && node tools/package.mjs",
    "publish:figma": "npm run build && node tools/figma-publish.mjs",
    "ui:preview": "node tools/ui-preview.mjs"
  },
  "dependencies": {
    "@create-figma-plugin/ui": "^4.0.3",
    "@create-figma-plugin/utilities": "^4.0.3",
    "fontkit": "^2.0.4",
    "pdf-lib": "^1.17.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@create-figma-plugin/build": "^4.0.3",
    "@eslint/js": "^9.39.0",
    "@figma/plugin-typings": "^1.134.0",
    "@types/fontkit": "^2.0.9",
    "@types/jsdom": "^30.0.0",
    "eslint": "^9.39.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  },
  "figma-plugin": {
    "editorType": [
      "figma",
      "slides"
    ],
    "id": "1672509720278498323",
    "name": "Featherweight",
    "main": "src/main.ts",
    "ui": "src/ui.tsx",
    "documentAccess": "dynamic-page",
    "networkAccess": {
      "allowedDomains": [
        "https://cdn.jsdelivr.net"
      ],
      "reasoning": "Downloads the open-licensed fonts your document uses (Inter, Roboto, Pretendard, Noto Sans KR and 56 more — all SIL OFL) so text can be embedded as real fonts instead of vector outlines. Fonts are served from the jsDelivr CDN at pinned versions. Nothing is uploaded; your document content never leaves the machine."
    }
  }
}
